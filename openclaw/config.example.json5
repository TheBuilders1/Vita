{
  gateway: {
    mode: "local",
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_TOKEN}",
    },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },

  models: {
    providers: {
      "ollama-cloud": {
        baseUrl: "https://ollama.com",
        api: "ollama",
        models: [
          // El catálogo de OpenClaw 2026.11.8 anuncia más salida de la que acepta Ollama Cloud.
          { id: "minimax-m3", name: "MiniMax M3", maxTokens: 131072 },
          {
            id: "glm-5.3-flash",
            name: "GLM-5.3 Flash",
            input: ["text", "image"],
            contextWindow: 1048576,
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  plugins: {
    allow: ["vita-tools", "ollama"],
    load: {
      paths: ["/absolute/path/to/Vita/openclaw/vita-tools"],
    },
    entries: {
      "vita-tools": { enabled: true },
      ollama: { enabled: true },
    },
  },

  // Cada agente tiene herramientas acotadas; sin buscador, el modelo las ve directamente.
  tools: { toolSearch: false },

  agents: {
    ownership: "explicit",
    defaults: {
      systemAgent: { agentId: "orquestador" },
      subagents: {
        maxSpawnDepth: 1,
        maxChildrenPerAgent: 1,
        maxConcurrent: 1,
        runTimeoutSeconds: 120,
      },
    },
    entries: {
      orquestador: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/orquestador",
        model: "ollama-cloud/glm-5.2",
        tools: {
          // Los hijos heredan las herramientas de esta lista. El orquestador
          // tiene ambas herramientas disponibles, pero sus instrucciones le
          // prohíben llamarlas directamente.
          allow: [
            "sessions_spawn",
            "sessions_yield",
            "vita_report_result",
            "vita_scan_document",
            "vita_read_google_calendar",
          ],
        },
        subagents: {
          allowAgents: ["documentos", "calendario"],
          requireAgentId: true,
        },
      },
      calendario: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/calendario",
        model: "ollama-cloud/minimax-m3",
        tools: {
          allow: ["vita_read_google_calendar"],
        },
        subagents: {
          allowAgents: [],
        },
      },
      documentos: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/documentos",
        model: "ollama-cloud/minimax-m3",
        tools: {
          allow: ["vita_scan_document"],
        },
        subagents: {
          allowAgents: [],
        },
      },
      "vita-vision-orquestador": {
        workspace: "/absolute/path/to/Vita/openclaw/agents/vita-vision-orquestador",
        model: "ollama-cloud/glm-5.2",
        tools: {
          allow: ["sessions_spawn", "sessions_yield"],
        },
        subagents: {
          allowAgents: ["vita-vision"],
          requireAgentId: true,
        },
      },
      "vita-vision": {
        workspace: "/absolute/path/to/Vita/openclaw/agents/vita-vision",
        model: "ollama-cloud/glm-5.3-flash",
        tools: {
          allow: ["vita_analyze_chat_images"],
        },
        subagents: {
          allowAgents: [],
        },
      },
    },
  },
}
