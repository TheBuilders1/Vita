{
  gateway: {
    mode: "local",
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_TOKEN}",
    },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },

  plugins: {
    allow: ["vita-tools"],
    load: {
      paths: ["/absolute/path/to/Vita/openclaw/vita-tools"],
    },
    entries: {
      "vita-tools": { enabled: true },
    },
  },

  // Cada agente tiene herramientas acotadas; sin buscador, el modelo las ve directamente.
  tools: { toolSearch: false },

  agents: {
    ownership: "explicit",
    defaults: {
      systemAgent: { agentId: "orquestador" },
      subagents: {
        maxSpawnDepth: 1,
        maxChildrenPerAgent: 1,
        maxConcurrent: 1,
        runTimeoutSeconds: 120,
      },
    },
    entries: {
      orquestador: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/orquestador",
        tools: {
          // Los hijos heredan las herramientas de esta lista. El orquestador
          // tiene ambas herramientas disponibles, pero sus instrucciones le
          // prohíben llamarlas directamente.
          allow: [
            "sessions_spawn",
            "sessions_yield",
            "vita_report_result",
            "vita_scan_document",
            "vita_read_google_calendar",
          ],
        },
        subagents: {
          allowAgents: ["documentos", "calendario"],
        },
      },
      calendario: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/calendario",
        tools: {
          allow: ["vita_read_google_calendar"],
        },
        subagents: {
          allowAgents: [],
        },
      },
      documentos: {
        workspace: "/absolute/path/to/Vita/openclaw/agents/documentos",
        tools: {
          allow: ["vita_scan_document"],
        },
        subagents: {
          allowAgents: [],
        },
      },
    },
  },
}
