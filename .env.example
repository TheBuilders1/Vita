POSTGRES_DB=vita
POSTGRES_PASSWORD=change-this-postgres-password
VITA_API_PASSWORD=change-this-api-password
VITA_MIGRATOR_PASSWORD=change-this-migrator-password

# Sustituye estos tokens de demostración antes de arrancar.
# Alba y Bruno comparten hogar; Carla pertenece a otro hogar.
VITA_DEMO_TOKENS='{"alba-demo-token-change-me":"11111111-1111-4111-8111-111111111111","bruno-demo-token-change-me":"22222222-2222-4222-8222-222222222222","carla-demo-token-change-me":"33333333-3333-4333-8333-333333333333"}'

# Debe coincidir con el token privado del Gateway OpenClaw.
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_TOKEN=replace-with-the-private-openclaw-gateway-token
OPENCLAW_AGENT_ID=orquestador
OPENCLAW_TIMEOUT_SECONDS=120

# OAuth de Google Calendar (solo lectura). Déjalas vacías para desactivar la integración.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Genera una clave Fernet independiente y guárdala como secreto fuera del repositorio.
GOOGLE_TOKEN_ENCRYPTION_KEY=
